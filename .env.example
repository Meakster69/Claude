# Alpaca Paper Trading Credentials
# Copy this file to .env and fill in your values.
# Get these from: https://app.alpaca.markets -> API Keys (Paper Trading)

# Main paper trading account (used by the daily bot)
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# "intraday Funding" paper account (used by the intraday bot)
INTRADAY_API_KEY=your_intraday_api_key_here
INTRADAY_SECRET_KEY=your_intraday_secret_key_here
INTRADAY_BASE_URL=https://paper-api.alpaca.markets
